+#### --disable-depth-infinity
+
+A PROPFIND request with ` + "`Depth: infinity`" + `, or with no Depth header,
+lists the whole directory tree in a single response. On a big tree this
+reads every directory and keeps all of them in the directory cache, which
+can use a lot of memory. With this flag such requests are rejected with
+a 403 Forbidden and a ` + "`propfind-finite-depth`" + ` error, as RFC 4918
+allows, so clients list one level at a time with ` + "`Depth: 1`" + `.
+
 ### Gzip compression
 
 The server will compress certain response bodies (text and XML, including
@@ -417,6 +432,16 @@ func (w *WebDAV) ServeHTTP(rw http.ResponseWriter, r *http.Request) {
 		http.Error(rw, http.StatusText(http.StatusBadRequest), http.StatusBadRequest)
 		return
 	}
+	if w.opt.DisableDepthInfinity && r.Method == "PROPFIND" {
+		// The webdav handler treats a missing Depth as infinity
+		if depth := r.Header.Get("Depth"); depth == "" || depth == "infinity" {
+			fs.Infof(urlPath, "%s with Depth infinity from %s rejected", r.Method, r.RemoteAddr)
+			rw.Header().Set("Content-Type", "application/xml; charset=utf-8")
+			rw.WriteHeader(http.StatusForbidden)
+			_, _ = io.WriteString(rw, `<?xml version="1.0" encoding="utf-8"?>`+"\n"+`<D:error xmlns:D="DAV:"><D:propfind-finite-depth/></D:error>`)
+			return
+		}
+	}
 	isDir := strings.HasSuffix(urlPath, "/")
 	remote := strings.Trim(urlPath, "/")
 	if !w.opt.DisableDirList && (r.Method == "GET" || r.Method == "HEAD") && isDir {
diff --git a/cmd/serve/webdav/webdav_test.go b/cmd/serve/webdav/webdav_test.go
index 8b10c9890..7b885c00c 100644
--- a/cmd/serve/webdav/webdav_test.go
+++ b/cmd/serve/webdav/webdav_test.go
@@ -16,6 +16,7 @@ import (
 	"net/http/httptest"
 	"os"
 	"path/filepath"
+	"strconv"
 	"strings"
 	"testing"
 
@@ -723,3 +724,40 @@ func testPathTraversal(t *testing.T, baseURL string) {
 		fstest.NewItem("served-root/dir/inside-dir.txt", "INSIDE DIR", modTime),
 	}, []string{"served-root", "served-root/dir"}, fs.GetModifyWindow(ctx, outside))
 }
+
+func TestDisableDepthInfinity(t *testing.T) {
+	ctx := context.Background()
+	f, err := fs.NewFs(ctx, ":memory:webdav-depth-test")
+	require.NoError(t, err)
+	_, err = operations.Rcat(ctx, f, "dir/file.txt", io.NopCloser(strings.NewReader("DATA")), fstest.Time("2001-02-03T04:05:06Z"), nil)
+	require.NoError(t, err)
+
+	for _, disable := range []bool{false, true} {
+		t.Run("DisableDepthInfinity="+strconv.FormatBool(disable), func(t *testing.T) {
+			opt := Opt
+			opt.HTTP.ListenAddr = []string{"localhost:0"}
+			opt.DisableDepthInfinity = disable
+			w, err := newWebDAV(ctx, f, &opt, &vfscommon.Opt, &proxy.Opt)
+			require.NoError(t, err)
+			w.server.Serve()
+			defer func() {
+				assert.NoError(t, w.Shutdown())
+			}()
+			for _, depth := range []string{"", "infinity", "1", "0"} {
+				req := httptest.NewRequest("PROPFIND", "/", nil)
+				if depth != "" {
+					req.Header.Set("Depth", depth)
+				}
+				rec := httptest.NewRecorder()
+				w.server.Router().ServeHTTP(rec, req)
+				if disable && (depth == "" || depth == "infinity") {
+					assert.Equal(t, http.StatusForbidden, rec.Code, "Depth %q", depth)
+					assert.Contains(t, rec.Body.String(), "<D:propfind-finite-depth/>", "Depth %q", depth)
+				} else {
+					assert.Equal(t, http.StatusMultiStatus, rec.Code, "Depth %q", depth)
+					assert.Equal(t, depth == "" || depth == "infinity", strings.Contains(rec.Body.String(), "file.txt"), "Depth %q", depth)
+				}
+			}
+		})
+	}
+}
