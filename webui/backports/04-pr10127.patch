+func TestSequentialUnknownSizeZIP(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	// A large ZIP is streamed without Content-Length, even after Open.
+	payload := random.String(65536)
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "payload"), []byte(payload), 0600))
+	local, err := fs.NewFs(ctx, dir)
+	require.NoError(t, err)
+	s, testURL := start(ctx, t, local)
+	t.Cleanup(func() { assert.NoError(t, s.Shutdown()) })
+	f, err := httpbackend.NewFs(ctx, "test", "", configmap.Simple{
+		"url":       strings.Replace(testURL, "://", "://"+testUser+":"+testPass+"@", 1),
+		"no_escape": "true",
+	})
+	require.NoError(t, err)
+	obj, err := f.NewObject(ctx, "?download=zip")
+	require.NoError(t, err)
+	require.Equal(t, int64(-1), obj.Size())
+	reader := chunkedreader.New(ctx, obj, -1, -1, 0)
+	_, err = reader.Open()
+	require.NoError(t, err)
+	t.Cleanup(func() { assert.NoError(t, reader.Close()) })
+	require.Equal(t, int64(-1), obj.Size())
+	data, err := io.ReadAll(reader)
+	require.NoError(t, err)
+	entries := readZip(t, data)
+	require.Len(t, entries, 1)
+	require.Equal(t, payload, entries["payload"].Contents)
+}
diff --git a/fs/chunkedreader/sequential.go b/fs/chunkedreader/sequential.go
index ee9400fb4..0fe5441d3 100644
--- a/fs/chunkedreader/sequential.go
+++ b/fs/chunkedreader/sequential.go
@@ -17,6 +17,7 @@ type sequential struct {
 	ctx              context.Context
 	mu               sync.Mutex    // protects following fields
 	o                fs.Object     // source to read from
+	expectedSize     int64         // fixed once known: reopening chunks can refresh o.Size and hide truncation
 	rc               io.ReadCloser // reader for the current open chunk
 	offset           int64         // offset the next Read will start. -1 forces a reopen of o
 	chunkOffset      int64         // beginning of the current or next chunk
@@ -32,6 +33,7 @@ func newSequential(ctx context.Context, o fs.Object, initialChunkSize int64, max
 	return &sequential{
 		ctx:              ctx,
 		o:                o,
+		expectedSize:     o.Size(),
 		offset:           -1,
 		chunkSize:        initialChunkSize,
 		initialChunkSize: initialChunkSize,
@@ -89,8 +91,13 @@ func (cr *sequential) Read(p []byte) (n int, err error) {
 		n += rn
 		cr.offset += int64(rn)
 		if err != nil {
-			if err == io.ErrUnexpectedEOF {
+			if err == io.EOF || err == io.ErrUnexpectedEOF {
+				// ReadFull also reports healthy short final chunks as unexpected EOF.
+				// An unknown (negative) size cannot prove that bytes are missing.
 				err = io.EOF
+				if cr.offset < cr.expectedSize {
+					err = io.ErrUnexpectedEOF
+				}
 			}
 			return
 		}
@@ -211,6 +218,10 @@ func (cr *sequential) openRange() error {
 	if err != nil {
 		return err
 	}
+	// Capture sizes learned on Open before another chunk can refresh them.
+	if cr.expectedSize < 0 {
+		cr.expectedSize = cr.o.Size()
+	}
 	return cr.resetReader(rc, offset)
 }
 
diff --git a/fs/chunkedreader/sequential_real_test.go b/fs/chunkedreader/sequential_real_test.go
