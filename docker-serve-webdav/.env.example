# Configurazione completa di docker-serve-webdav: copia questo file in .env
# e modificalo. È l'unico posto dove stanno i valori: docker-compose.yml
# li legge per immagine, porte, utente e cartelle (sezione 1) e passa
# l'intero file al container come ambiente (sezioni 2-7).
#
# Ogni RCLONE_<NOME> imposta il flag --<nome> di rclone: RCLONE_WEBUI_SEARCH
# equivale a --webui-search, RCLONE_VFS_CACHE_MODE a --vfs-cache-mode.
#
# Regole:
# - lascia commentate le variabili che non usi: una variabile presente ma
#   vuota (RCLONE_X=) è comunque impostata, e per booleani, durate e
#   dimensioni rclone si ferma all'avvio con "Invalid value";
# - docker compose interpreta il carattere $ anche qui: in password e
#   segreti racchiudi il valore tra apici singoli (RCLONE_PASS='pa$word',
#   dentro gli apici $ resta $) oppure, senza apici, scrivi $$ per ogni $;
# - durate: 30s, 5m, 1h, 3d; dimensioni: 32M, 4Mi, 20G; booleani: true/false.

# ---------------------------------------------------------------------------
# 1. Compose: immagine, porta, utente, cartelle dell'host
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=rclone-webdav

# Immagine: latest = ultima release del fork, X.Y.Z-webui.N = una release
# precisa (consigliata in produzione), main = ultima build del ramo main.
WEBDAV_IMAGE=ghcr.io/manprint/rclone:latest
WEBDAV_CONTAINER_NAME=rclone-webdav

# Indirizzo e porta dell'host su cui è pubblicato il server. 127.0.0.1 lo
# espone solo alla macchina, per esempio dietro un reverse proxy.
WEBDAV_BIND=0.0.0.0
WEBDAV_PORT=8080

# Utente e gruppo con cui gira rclone (id -u e id -g sull'host).
PUID=1000
PGID=1000

# Cartelle dell'host montate nel container (/config/rclone, /cache, /data).
WEBDAV_CONFIG_DIR=./config
WEBDAV_CACHE_DIR=./cache
WEBDAV_DATA_DIR=./data

# Remote servito: /data (la cartella WEBDAV_DATA_DIR) oppure un remote di
# rclone.conf, per esempio "s3:bucket/cartella" o "locale:".
WEBDAV_REMOTE=/data

# ---------------------------------------------------------------------------
# 2. Percorsi interni del container
# ---------------------------------------------------------------------------
# Legati ai volumi e alla porta interna del compose: non cambiarli.

RCLONE_ADDR=:8080
RCLONE_CONFIG=/config/rclone/rclone.conf
RCLONE_CACHE_DIR=/cache
RCLONE_WEBUI_RESUME_DIR=/cache/webui/resume
TZ=Europe/Rome

# ---------------------------------------------------------------------------
# 3. Autenticazione e rete (flag upstream di serve webdav)
# ---------------------------------------------------------------------------

# Utente singolo. La password è leggibile con "docker inspect": per un uso
# reale preferisci RCLONE_HTPASSWD. Senza utente né htpasswd il server non
# chiede credenziali.
RCLONE_USER=admin
RCLONE_PASS=cambiami

# File htpasswd (monta ./auth:/auth:ro nel compose). Sostituisce USER/PASS.
# RCLONE_HTPASSWD=/auth/htpasswd

# Realm dell'autenticazione Basic (default rclone).
# RCLONE_REALM=rclone

# Utente preso da un header impostato dal reverse proxy.
# RCLONE_USER_FROM_HEADER=X-Remote-User

# Prefisso di tutti gli URL, per servire sotto un percorso del proxy.
# RCLONE_BASEURL=/webdav

# TLS diretto (monta ./certs:/certs:ro nel compose).
# RCLONE_CERT=/certs/fullchain.pem
# RCLONE_KEY=/certs/privkey.pem

# CORS per un client web servito da un'altra origine.
# RCLONE_ALLOW_ORIGIN=https://app.example.com

# Sola lettura per tutti: l'interfaccia nasconde upload, modifica e
# cancellazione, le scritture dei client WebDAV sono rifiutate.
# RCLONE_READ_ONLY=true
# RCLONE_DISABLE_ZIP=true

# File e cartelle nascosti e non accessibili (filtri di rclone), pattern
# separati da virgola, senza graffe: equivale a --hidden di superdufs.
# RCLONE_EXCLUDE=*.log,*.lock,tmp/**
# RCLONE_MAX_HEADER_BYTES=4096
# RCLONE_ETAG_HASH=auto

# Durata massima di una richiesta e di una risposta: un film visto per
# intero, un download o un upload grande superano l'ora di default.
RCLONE_SERVER_READ_TIMEOUT=12h
RCLONE_SERVER_WRITE_TIMEOUT=12h

# ---------------------------------------------------------------------------
# 4. Elenchi veloci delle cartelle (flag upstream)
# ---------------------------------------------------------------------------

# Le cartelle restano in cache un'ora invece di essere rilette dal remote a
# ogni apertura (default di rclone 5m). Le modifiche fatte da questo server
# si vedono subito; quelle fatte da fuori arrivano con il polling sui remote
# che lo supportano (Drive, OneDrive, Dropbox, ...) e altrimenti alla
# scadenza: con /data, se modifichi spesso i file direttamente sull'host,
# abbassa a 1m.
RCLONE_DIR_CACHE_TIME=1h
# Intervallo del polling dei cambiamenti, minore di RCLONE_DIR_CACHE_TIME
# (0 = spento).
RCLONE_POLL_INTERVAL=1m
# All'avvio legge in background l'intero albero, con un elenco ricorsivo
# (ListR) sui backend che lo offrono: prime aperture e ricerca istantanee.
# Su remote enormi costa molte richieste: metti false.
RCLONE_VFS_REFRESH=true
# Riconosce i file in cache da dimensione e data senza calcolare hash, più
# veloce su S3, Swift e simili.
RCLONE_VFS_FAST_FINGERPRINT=true

# ---------------------------------------------------------------------------
# 5. Cache e streaming video (flag upstream)
# ---------------------------------------------------------------------------

# full: cache su disco a blocchi, seek dei video senza riscaricare e ripresa
# degli upload interrotti dall'interfaccia. writes usa meno disco ma ogni
# lettura torna al remote; off e minimal non riprendono gli upload.
RCLONE_VFS_CACHE_MODE=full
# Limiti della cache: dimensione massima, età dall'ultimo accesso, spazio
# minimo da lasciare libero sul disco di WEBDAV_CACHE_DIR.
RCLONE_VFS_CACHE_MAX_SIZE=20G
RCLONE_VFS_CACHE_MAX_AGE=24h
RCLONE_VFS_CACHE_MIN_FREE_SPACE=2G
# Primo blocco letto dal remote piccolo (avvio e seek rapidi), poi blocchi
# che raddoppiano fino al limite.
RCLONE_VFS_READ_CHUNK_SIZE=32M
RCLONE_VFS_READ_CHUNK_SIZE_LIMIT=1G
# Letture in parallelo a blocchi fissi per remote ad alta latenza (S3,
# Swift): per esempio 16 con RCLONE_VFS_READ_CHUNK_SIZE=4M. 0 = un flusso.
RCLONE_VFS_READ_CHUNK_STREAMS=0
# Lettura anticipata su disco oltre al buffer in memoria (solo con full).
RCLONE_VFS_READ_AHEAD=256M
RCLONE_BUFFER_SIZE=32M
# Il browser legge un video con molte richieste Range: tiene aperto il
# lettore tra una richiesta e l'altra invece di riaprirlo sul remote.
RCLONE_VFS_HANDLE_CACHING=30s

# Upload in parallelo dalla cache verso il remote e ritardo dell'upload
# dopo la chiusura del file.
# RCLONE_TRANSFERS=4
# RCLONE_VFS_WRITE_BACK=5s

# Statistiche di spazio e date.
# RCLONE_VFS_DISK_SPACE_TOTAL_SIZE=1T
# RCLONE_VFS_USED_IS_SIZE=true
# RCLONE_NO_MODTIME=true

# ---------------------------------------------------------------------------
# 6. Interfaccia web del fork (flag --webui-*)
# ---------------------------------------------------------------------------

# Interfaccia attiva per i browser (false = server identico a upstream).
RCLONE_WEBUI=true

# Segreto che firma token di download e link pubblici: senza, i link
# smettono di funzionare a ogni riavvio. Usa una frase lunga e casuale,
# per esempio: openssl rand -base64 32
# RCLONE_WEBUI_SECRET=una-frase-lunga-e-casuale

# Durata dei token di download (72h = 3d).
# RCLONE_WEBUI_TOKEN_EXPIRY=72h

# Percorsi con link pubblici permanenti, separati da virgola; / = tutto.
# RCLONE_WEBUI_PUBLINK_PATHS=/condivisi,/foto/2026

# Ricerca ricorsiva.
# RCLONE_WEBUI_SEARCH=true
# RCLONE_WEBUI_SEARCH_MAX_DEPTH=8
# RCLONE_WEBUI_SEARCH_MAX_RESULTS=1000
# RCLONE_WEBUI_SEARCH_TIMEOUT=30s

# Ripresa della riproduzione di audio e video (salvata in /cache/webui/resume).
RCLONE_WEBUI_RESUME=true
# RCLONE_WEBUI_RESUME_RETENTION=720h

# Player: tentativi e secondi tra le riconnessioni.
# RCLONE_WEBUI_PLAYER_MAX_RETRY=30
# RCLONE_WEBUI_PLAYER_RECONNECT_INTERVAL=10

# Statistiche di spazio, impostazioni di upload concorrenti, conteggio
# degli elementi delle cartelle (costoso: un elenco per sottocartella).
# RCLONE_WEBUI_DISK_STATS=true
# RCLONE_WEBUI_UPLOAD_SETTINGS=true
# RCLONE_WEBUI_DIR_COUNT=true

# Dimensione massima di un file modificabile, elementi massimi di uno zip
# da selezione multipla.
# RCLONE_WEBUI_EDIT_MAX_SIZE=4Mi
# RCLONE_WEBUI_MULTI_ZIP_MAX=200

# ---------------------------------------------------------------------------
# 7. Log
# ---------------------------------------------------------------------------

# INFO in produzione: con DEBUG rclone scrive nel log i valori delle
# variabili d'ambiente, password e segreto compresi.
RCLONE_LOG_LEVEL=INFO
